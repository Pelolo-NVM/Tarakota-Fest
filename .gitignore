# Environment secrets (jangan pernah commit file kredensial nyata)
.env
.env.*
.env.local
.env.production
!.env.example

# Direktori dan file vendor / dependencies
vendor/
node_modules/
composer.phar

# Uploads dinamis pengguna (kecualikan placeholder gitkeep)
uploads/proofs/*
!uploads/proofs/.gitkeep
uploads/posters/*
!uploads/posters/.gitkeep

# File sementara, log, backup, session
*.log
*.tmp
*.bak
sess_*

# Pengaturan IDE / Editor & Windows lokal
.vscode/
.idea/
*.swp
desktop.ini
Thumbs.db

# Environment testing lokal
thunder-tests/thunderEnvironment.json
